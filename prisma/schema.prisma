// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator business_client {
  provider = "prisma-client-js"
  output   = "../app/generated/business/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("BUSINESS_DATABASE_URL")
}

// Minimal model to initialize a per-business database by creating a collection
model SystemSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

model BusinessUser {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  displayName String   @default("")
  role        UserRole @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates      Templates[]
  ComponentBlock ComponentBlock[]
  approvals      Approver[]
}

// ========= TEMPLATE MODELS =========
model Templates {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title    String            @unique
  filePath String
  versions TemplateVersion[]

  campaigns CampaignTemplate[]

  userId String       @db.ObjectId
  user   BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvers Approver[]

  contactList   ContactList? @relation(fields: [contactListId], references: [id])
  contactListId String?      @db.ObjectId

  requiredFields String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum APPROVAL_STATUS {
  PENDING
  APPROVED
  REJECTED
}

model Approver {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relations - one of these must be set
  templateId       String?         @db.ObjectId
  template         Templates?      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  componentBlockId String?         @db.ObjectId
  componentBlock   ComponentBlock? @relation(fields: [componentBlockId], references: [id], onDelete: Cascade)

  userId String       @db.ObjectId
  user   BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  status APPROVAL_STATUS @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, componentBlockId, userId])
  @@index([templateId])
  @@index([componentBlockId])
  @@index([userId])
}

model TemplateVersion {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  templateId String    @db.ObjectId
  template   Templates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    String
  filePath   String
  createdAt  DateTime  @default(now())
}

// ========= COMPONENT BLOCK MODELS =========
model ComponentBlock {
  id        String                  @id @default(auto()) @map("_id") @db.ObjectId
  name      String                  @unique
  filePath  String
  userId    String                  @db.ObjectId
  user      BusinessUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  ComponentBlockVersion[]
  approvers Approver[]

  contactList   ContactList? @relation(fields: [contactListId], references: [id])
  contactListId String?      @db.ObjectId

  requiredFields String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComponentBlockVersion {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  componentBlockId String         @db.ObjectId
  componentBlock   ComponentBlock @relation(fields: [componentBlockId], references: [id], onDelete: Cascade)
  version          String
  filePath         String
  createdAt        DateTime       @default(now())
}

// ========= CUSTOMER MODELS =========

enum CONTACT_SOURCE {
  MANUAL
  CSV_UPLOAD
  SALESFORCE
}

model ContactList {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  fields    Json[]
  customers Customer[]
  source    CONTACT_SOURCE?
  remarks   String?

  primaryKey String  @default("")
  upsertMode Boolean @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  templates       Templates[]
  componentBlocks ComponentBlock[]
  campaigns       Campaign[]
}

model Customer {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  listId String      @db.ObjectId
  list   ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
}

// ======== CAMPAIGN =========

enum SCHEDULE_STATUS {
  PENDING
  TRIGGERED
  FAILED
}

enum FILE_STATUS {
  EMPTY
  PENDING
  AVALIABLE
  FAILED
  EXPIRED
}

model Campaign {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  templates      CampaignTemplate[]
  contactlist   ContactList        @relation(fields: [contactListId], references: [id])
  contactListId String             @db.ObjectId

  scheduledAt    DateTime
  scheduleStatus SCHEDULE_STATUS @default(PENDING)
  executedAt     DateTime?

  fileStatus FILE_STATUS @default(EMPTY)

  totalRecords Int @default(0)

  logs CampaignLog[]
  files CampaignFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status  SCHEDULE_STATUS
  message String?

  createdAt DateTime @default(now())
}

model CampaignTemplate {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String @db.ObjectId
  templateId String @db.ObjectId

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template Templates @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, templateId])
  @@index([campaignId])
  @@index([templateId])
}

model CampaignFile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  fileName String
  filePath String
  status   FILE_STATUS @default(PENDING)
  isDeleted Boolean     @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

// ======== MIGRATION MODEL (for tracking applied migrations in each business database) =========

model Migration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  appliedAt DateTime @default(now())
}
