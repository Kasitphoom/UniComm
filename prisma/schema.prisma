// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator business_client {
  provider = "prisma-client-js"
  output   = "../app/generated/business/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("BUSINESS_DATABASE_URL")
}

// Minimal model to initialize a per-business database by creating a collection
model SystemSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

model BusinessUser {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  displayName String   @default("")
  role        UserRole @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates      Templates[]
  ComponentBlock ComponentBlock[]
}

// ========= TEMPLATE MODELS =========
model Templates {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  title     String            @unique
  filePath  String
  userId    String
  user      BusinessUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  TemplateVersion[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model TemplateVersion {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  templateId String
  template   Templates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    String
  filePath   String
  createdAt  DateTime  @default(now())
}

// ========= COMPONENT BLOCK MODELS =========
model ComponentBlock {
  id        String                  @id @default(auto()) @map("_id") @db.ObjectId
  name      String                  @unique
  filePath  String
  userId    String
  user      BusinessUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  ComponentBlockVersion[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model ComponentBlockVersion {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  componentBlockId String
  componentBlock   ComponentBlock @relation(fields: [componentBlockId], references: [id], onDelete: Cascade)
  version          String
  filePath         String
  createdAt        DateTime       @default(now())
}

// ========= CUSTOMER MODELS =========

enum CONTACT_SOURCE {
  MANUAL
  CSV_UPLOAD
  SALESFORCE
}

model ContactList {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  fields    Json[]
  customers Customer[]
  source    CONTACT_SOURCE?
  remarks   String?

  primaryKey String  @default("")
  upsertMode Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  listId String      @db.ObjectId
  list   ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
}
