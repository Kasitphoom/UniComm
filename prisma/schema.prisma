// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator business_client {
  provider = "prisma-client-js"
  output   = "../app/generated/business/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("BUSINESS_DATABASE_URL")
}

// Minimal model to initialize a per-business database by creating a collection
model SystemSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

model BusinessUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  displayName String @default("")
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates Templates[]
}

// ========= TEMPLATE MODELS =========
model Templates {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   @unique
  filePath    String
  userId      String
  user        BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    TemplateVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TemplateVersion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String
  template    Templates @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  filePath    String
  createdAt   DateTime @default(now())
}